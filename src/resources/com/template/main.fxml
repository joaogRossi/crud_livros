<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFF4F2;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">

    <children>

        <Label layoutX="14.0" layoutY="29.0" text="Título" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtTitulo" layoutX="92.0" layoutY="27.0" prefHeight="25.0" prefWidth="180.0" style="-fx-background-radius: 30;" text="joao" />

        <Label layoutX="14.0" layoutY="72.0" text="Autor" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtAutor" layoutX="92.0" layoutY="70.0" prefHeight="25.0" prefWidth="180.0" style="-fx-background-radius: 30;" text="joao" />

        <Label layoutX="14.0" layoutY="112.0" text="Gênero" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtGenero" layoutX="92.0" layoutY="110.0" prefHeight="25.0" prefWidth="180.0" style="-fx-background-radius: 30;" text="masculino" />

        <Label layoutX="312.0" layoutY="29.0" text="Ano" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtAno_publicacao" layoutX="369.0" layoutY="27.0" prefHeight="25.0" prefWidth="192.0" style="-fx-background-radius: 30;" text="2026" />

        <Label layoutX="312.0" layoutY="72.0" text="Preço" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtPreco" layoutX="369.0" layoutY="70.0" prefHeight="25.0" prefWidth="192.0" style="-fx-background-radius: 30;" text="50" />

        <Label layoutX="312.0" layoutY="114.0" text="ID" textFill="#42227a">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TextField fx:id="txtID" editable="false" layoutX="369.0" layoutY="110.0" prefHeight="25.0" prefWidth="192.0" style="-fx-background-radius: 30;" text="1" />

        <TableView fx:id="tblLivros" layoutX="111.0" layoutY="175.0" onMouseClicked="#carregarCampos" prefHeight="200.0" prefWidth="476.0" style="-fx-background-color: #FFE2DB;">

            <columns>
                <TableColumn fx:id="colID" prefWidth="35.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="ID" />

                <TableColumn fx:id="colTitulo" prefWidth="95.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="Título" />

                <TableColumn fx:id="colAutor" prefWidth="90.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="Autor" />

                <TableColumn fx:id="colAno_publicacao" prefWidth="95.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="Ano" />

                <TableColumn fx:id="colGenero" prefWidth="80.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="Gênero" />

                <TableColumn fx:id="colPreco" prefWidth="80.0" style="-fx-background-color: #42227A; -fx-text-background-color: #FFFFFF;" text="Preço" />
            </columns>
        </TableView>

        <Button fx:id="btnCadastrar" layoutX="28.0" layoutY="188.0" mnemonicParsing="false" onAction="#btnCadastrarAction" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #ff914d;" text="Salvar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnEditar" layoutX="28.0" layoutY="226.0" mnemonicParsing="false" onAction="#btnEditarAction" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #ff914d;" text="Editar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnDeletar" layoutX="28.0" layoutY="263.0" mnemonicParsing="false" onAction="#btnDeletarAction" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #ff914d;" text="Deletar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

        <Button fx:id="btnLimpar" layoutX="28.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnLimparAction" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #ff914d;" text="Limpar" textFill="WHITE">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

    </children>
</AnchorPane>
